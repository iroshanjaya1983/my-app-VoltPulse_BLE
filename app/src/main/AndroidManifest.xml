<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow minSdk 21 compatibility across AndroidX libraries -->
    <uses-sdk
        tools:overrideLibrary="androidx.core.ktx, androidx.core, androidx.activity.compose, androidx.activity, androidx.lifecycle.runtime.ktx, androidx.lifecycle.service, androidx.lifecycle.viewmodel.compose, androidx.lifecycle.runtime.compose, androidx.compose.ui, androidx.compose.material3, androidx.compose.material.icons.core, androidx.compose.material.icons.extended, androidx.appcompat" />

    <!-- BLE Hardware requirement -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Legacy Bluetooth & Location permissions (Android 5.0 Lollipop to Android 11 / API 21-30) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Modern Bluetooth permissions (Android 12+ / API 31+) -->
    <!-- neverForLocation strongly asserts BLE scanning is strictly for hardware peripherals -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />

    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ (API 34+) specific foreground service type for BLE peripheral connection -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!-- Post notifications permission for Android 13+ (API 33+) -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- Battery optimization exemption for OEM background survival (Samsung, MIUI, EMUI, Sony) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground BLE Service -->
        <service
            android:name=".BatteryBleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            tools:targetApi="34" />

    </application>

</manifest>
